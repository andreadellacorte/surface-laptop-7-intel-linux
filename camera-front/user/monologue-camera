#!/bin/bash
# Start the camera bridge, run Monologue, stop the bridge when Monologue exits.
systemctl --user start surface-camera.service
for i in $(seq 1 30); do   # wait (max 3s) until the virtual webcam is producing frames
  v4l2-ctl -d /dev/video50 --all 2>/dev/null | grep -q 'Video Capture' && break
  sleep 0.1
done
monologue "$@"
systemctl --user stop surface-camera.service
